{
  "manifest_version": 3,
  "name": "GX Browser Core — AdBlocker DNR Ruleset",
  "version": "2.0.0",
  "description": "Internal bundled DNR ad & tracker ruleset for nextGx Browser.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "gx_adblock_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
