{
  "author": "Marjan",
  "build": {
    "appId": "com.marjan.nextgxbrowser",
    "deb": {
      "depends": [
        "libasound2t64 (>= 1.0.17)",
        "libatk-bridge2.0-0t64 (>= 2.5.3)",
        "libatk1.0-0t64 (>= 2.32.0)",
        "libatspi2.0-0t64 (>= 2.9.90)",
        "libc6 (>= 2.34)",
        "libcairo2 (>= 1.14.0)",
        "libcups2t64 (>= 1.7.0)",
        "libdbus-1-3 (>= 1.9.14)",
        "libexpat1 (>= 2.1~beta3)",
        "libgbm1 (>= 21.1.0)",
        "libgcc-s1 (>= 4.2)",
        "libglib2.0-0t64 (>= 2.50.0)",
        "libgtk-3-0t64 (>= 3.9.10)",
        "libnspr4 (>= 2:4.9-2~)",
        "libnss3 (>= 2:3.30)",
        "libpango-1.0-0 (>= 1.14.0)",
        "libudev1 (>= 183)",
        "libx11-6 (>= 2:1.4.99.1)",
        "libxcb1 (>= 1.9.2)",
        "libxcomposite1 (>= 1:0.4.5)",
        "libxdamage1 (>= 1:1.1)",
        "libxext6",
        "libxfixes3",
        "libxkbcommon0 (>= 0.5.0)",
        "libxrandr2"
      ]
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "LICENSE",
      "src/**/*"
    ],
    "linux": {
      "category": "Network;WebBrowser",
      "maintainer": "Muse <muse@local>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "productName": "nextGx Browser",
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "description": "nextGx Browser — Modern Apple-Crafted Chromium Desktop Browser with Built-in Privacy Shield, Media Dock, Pro Download Manager, and 8 GB Memory Saver",
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/johnsmith68268-prog/nextGxBrowser",
  "keywords": [
    "nextgx",
    "browser",
    "chromium",
    "electron",
    "adblocker",
    "music-player"
  ],
  "license": "MIT",
  "main": "src/main.js",
  "name": "nextgx-browser",
  "productName": "nextGx Browser",
  "scripts": {
    "build:all": "electron-builder --linux AppImage deb --win nsis",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:win": "electron-builder --win nsis",
    "dev": "node scripts/launch.js --enable-logging",
    "start": "node scripts/launch.js"
  },
  "version": "3.0.0"
}
