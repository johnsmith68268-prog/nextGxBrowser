{
  "name": "nextgx-browser",
  "productName": "nextGx Browser",
  "desktopName": "nextgx-browser.desktop",
  "version": "3.2.1",
  "homepage": "https://github.com/johnsmith68268-prog/nextGxBrowser",
  "description": "nextGx Browser — Modern Apple-Crafted Chromium Desktop Browser with Built-in Privacy Shield, Media Dock, Pro Download Manager, and 8 GB Memory Saver",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js --enable-logging",
    "test": "node --test tests/*.test.js",
    "build:linux": "electron-builder --linux AppImage deb --publish never",
    "build:win": "electron-builder --win nsis portable --publish never",
    "build:win:exe": "electron-builder --win nsis --publish never",
    "build:win:msix": "electron-builder --win appx --publish never",
    "build:win:all": "electron-builder --win nsis portable --publish never"
  },
  "keywords": [
    "nextgx",
    "browser",
    "chromium",
    "electron",
    "adblocker",
    "music-player"
  ],
  "author": "Marjan",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.marjan.nextgxbrowser",
    "productName": "nextGx Browser",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "gx-extension/**/*",
      "build/adguard-mv3.zip",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "gx-extension/**/*",
      "build/adguard-mv3.zip",
      "build/icon.ico",
      "build/icon.png"
    ],
    "protocols": [
      {
        "name": "nextGx Browser Web Protocol",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "maintainer": "MD ABDULLAH AL MARZAN <johnsmith68268@gmail.com>",
      "vendor": "Marjan",
      "synopsis": "Modern Chromium Desktop Browser with Built-in Privacy Shield & 8 GB Memory Saver",
      "category": "Network;WebBrowser",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "nextGx-Browser-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "nextGx Browser",
          "Comment": "Modern Gaming Chromium Desktop Browser",
          "Categories": "Network;WebBrowser;",
          "MimeType": "text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;"
        }
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "nextGx Browser",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "appx": {
      "applicationId": "Marjan.nextGxBrowser",
      "identityName": "Marjan.nextGxBrowser",
      "publisher": "CN=Marjan",
      "publisherDisplayName": "Marjan",
      "backgroundColor": "#0e0a1a",
      "displayName": "nextGx Browser",
      "showNameOnTiles": true,
      "artifactName": "${productName}-${version}-${arch}.msix"
    }
  }
}
