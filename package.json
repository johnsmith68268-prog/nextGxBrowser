{
  "name": "nextgx-browser",
  "productName": "nextGx Browser",
  "version": "3.0.0",
  "description": "nextGx Browser — Modern Apple-Crafted Chromium Desktop Browser with Built-in Privacy Shield, Media Dock, Pro Download Manager, and 8 GB Memory Saver",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js --enable-logging",
    "test": "node --test tests/*.test.js",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:win": "electron-builder --win nsis portable",
    "build:win:exe": "electron-builder --win nsis",
    "build:win:msix": "electron-builder --win appx",
    "build:win:all": "electron-builder --win nsis portable appx"
  },
  "keywords": [
    "nextgx",
    "browser",
    "chromium",
    "electron",
    "adblocker",
    "music-player"
  ],
  "author": "Marjan",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.marjan.nextgxbrowser",
    "productName": "nextGx Browser",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "nextGx Browser",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "appx": {
      "applicationId": "Marjan.nextGxBrowser",
      "identityName": "Marjan.nextGxBrowser",
      "publisher": "CN=Marjan",
      "publisherDisplayName": "Marjan",
      "backgroundColor": "#120f0a",
      "displayName": "nextGx Browser",
      "showNameOnTiles": true,
      "artifactName": "${productName}-${version}-${arch}.msix"
    }
  }
}
